INSERT INTO `cms_content` VALUES (1,'海康威视AI视觉检测系统深度测评','Hikvision AI Vision Inspection System In-depth Review','video','/products/placeholder-content.svg',NULL,'工业视觉达人',125601,'review','["AI检测","海康威视","测评"]',1,'2026-01-29 11:05:18'),(2,'基恩士vs康耐视 | 3D视觉传感器横评','Keyence vs Cognex | 3D Vision Sensor Comparison','video','/products/placeholder-content.svg',NULL,'智能制造观察者',89200,'review','["基恩士","康耐视","3D视觉"]',1,'2026-01-29 11:05:18'),(3,'如何选择工业相机?5个关键参数详解','How to Choose Industrial Cameras? 5 Key Parameters','article','/products/placeholder-content.svg',NULL,'机器视觉专家',8500,'tutorial','["工业相机","选购指南"]',1,'2026-01-29 11:05:18'),(4,'探厂实拍 | 走进深圳AI视觉检测设备制造商','Factory Tour | Inside Shenzhen AI Vision Equipment Manufacturer','vlog','/products/placeholder-content.svg',NULL,'工业探厂Vlog',234002,'vlog','["探厂","深圳","制造业"]',1,'2026-01-29 11:05:18');

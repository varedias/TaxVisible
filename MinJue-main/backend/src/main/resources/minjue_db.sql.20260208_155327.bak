DROP TABLE IF EXISTS `oms_leasing`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `oms_leasing` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键ID',
  `name` varchar(200) NOT NULL COMMENT '设备名称',
  `type` varchar(20) NOT NULL COMMENT '租赁类型: financing-融资租赁, operating-经营租赁',
  `image` varchar(255) DEFAULT NULL COMMENT '设备图片URL',
  `description` text COMMENT '设备描述',
  `supplier` varchar(100) DEFAULT NULL COMMENT '供应商名称',
  `supplier_id` bigint DEFAULT NULL COMMENT '供应商ID',
  `monthly_price` decimal(10,2) DEFAULT NULL COMMENT '月租金',
  `total_price` decimal(10,2) DEFAULT NULL COMMENT '设备总价',
  `duration` varchar(50) DEFAULT NULL COMMENT '租期(如: 36个月)',
  `daily_price` decimal(10,2) DEFAULT NULL COMMENT '日租金',
  `weekly_price` decimal(10,2) DEFAULT NULL COMMENT '周租金',
  `benefits` text COMMENT '服务优势(JSON数组)',
  `tags` text COMMENT '标签(JSON数组)',
  `leased` int DEFAULT '0' COMMENT '已租次数',
  `rating` decimal(2,1) DEFAULT '5.0' COMMENT '评分',
  `status` tinyint DEFAULT '1' COMMENT '状�? 1-上架, 0-下架',
  `create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `update_time` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=22 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='租赁设备�?;
/*!40101 SET character_set_client = @saved_cs_client */;


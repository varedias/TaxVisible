INSERT INTO `pms_comment` VALUES (1,1,4,'张先�?,'https://ui-avatars.com/api/?name=ZS&background=random',5,'设备非常好用，精度高，检测速度快，售后服务也很到位。已经用�?个月，运行稳定，推荐购买�?,NULL,234,1,'2026-01-29 15:31:34'),(2,1,5,'李工','https://ui-avatars.com/api/?name=LG&background=random',5,'公司采购了多台，效果非常好。技术支持响应很快，解决问题很专业�?,NULL,189,1,'2026-01-29 15:31:34'),(3,1,6,'王经�?,'https://ui-avatars.com/api/?name=WJL&background=random',4,'总体不错，性价比很高。操作简单，功能实用�?,NULL,156,1,'2026-01-29 15:31:34'),(4,2,4,'张先�?,'https://ui-avatars.com/api/?name=ZS&background=random',5,'缺陷检测准确率很高，大大提升了我们的质检效率�?,NULL,145,1,'2026-01-29 15:31:34'),(5,2,7,'赵六','https://ui-avatars.com/api/?name=ZL&background=random',5,'深度学习算法确实强大，各种缺陷都能识别出来�?,NULL,98,1,'2026-01-29 15:31:34'),(6,3,5,'李工','https://ui-avatars.com/api/?name=LG&background=random',5,'3D视觉传感器精度很高，满足我们的测量需求�?,NULL,87,1,'2026-01-29 15:31:34'),(7,4,6,'王经�?,'https://ui-avatars.com/api/?name=WJL&background=random',5,'模具监测系统很实用，帮我们避免了很多模具损坏�?,NULL,123,1,'2026-01-29 15:31:34'),(8,5,4,'张先�?,'https://ui-avatars.com/api/?name=ZS&background=random',4,'模具保护器效果不错，性价比高�?,NULL,67,1,'2026-01-29 15:31:34'),(9,6,7,'赵六','https://ui-avatars.com/api/?name=ZL&background=random',5,'Basler相机画质清晰，帧率稳定，很满意�?,NULL,234,1,'2026-01-29 15:31:34'),(10,6,5,'李工','https://ui-avatars.com/api/?name=LG&background=random',5,'工业相机性能稳定，已经用了半年没出过问题�?,NULL,178,1,'2026-01-29 15:31:34');

DROP TABLE IF EXISTS `cms_content`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `cms_content` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `title` varchar(200) NOT NULL COMMENT 'Title',
  `title_en` varchar(200) DEFAULT NULL COMMENT 'English Title',
  `type` varchar(20) DEFAULT NULL COMMENT 'Type: video, article, vlog',
  `cover` varchar(255) DEFAULT NULL COMMENT 'Cover Image URL',
  `content_url` text COMMENT 'Content URL or Body',
  `author` varchar(50) DEFAULT NULL COMMENT 'Author',
  `views` int DEFAULT '0' COMMENT 'View Count',
  `category` varchar(50) DEFAULT NULL COMMENT 'Category: review, tutorial, vlog, news',
  `tags` text COMMENT 'Tags (JSON Array)',
  `status` tinyint DEFAULT '1' COMMENT '1:Published, 0:Draft',
  `create_time` datetime DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=5 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Content/Discovery';
/*!40101 SET character_set_client = @saved_cs_client */;

